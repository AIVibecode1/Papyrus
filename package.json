{
  "name": "papyrus",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm typecheck && pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "mock-ai": "node dev/mock-ai-server.mjs",
    "test": "pnpm exec vitest run",
    "test:dev": "node --test dev/__tests__/mock-ai-server.test.mjs dev/__tests__/check-release-integrity.test.mjs",
    "check:release": "node dev/check-release-integrity.mjs",
    "tauri": "tauri",
    "lint": "pnpm exec eslint .",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.4.0",
    "shadcn": "^4.16.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
